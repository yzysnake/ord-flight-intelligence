# Copy to .env (git-ignored) and fill in only the providers you adopt.
# Never commit real credentials. Each provider needs a data-catalog card first.

# Chicago Data Portal (Socrata app token; avoids shared-pool throttling)
SOCRATA_APP_TOKEN=

# OpenSky Network: OAuth2 client credentials (non-profit research use only)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Routing / traffic provider (chosen in ADR-0004)
MAPBOX_ACCESS_TOKEN=

# Optional licensed flight-status provider (chosen in ADR-0004)
AERODATABOX_API_KEY=
